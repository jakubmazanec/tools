{
  "name": "@jakubmazanec/carson-templates",
  "version": "9.1.0",
  "description": "Collection of Carson templates.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/tools.git",
    "directory": "packages/carson-templates"
  },
  "license": "MIT",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./build/main.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "source",
    "templates"
  ],
  "scripts": {
    "build": "del-cli build tsconfig.tsbuildinfo && esbuild \"source/**/*\" --platform=node --target=node24.21 --outdir=build --sourcemap && tsc",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "develop": "concurrently \"esbuild \"source/**/*\" --platform=node --target=node24.21 --outdir=build --sourcemap --watch\" \"tsc --watch\"",
    "document": "del-cli docs && typedoc --options typedoc.config.cjs",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "lodash": "^4.18.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@jakubmazanec/carson": "^3.0.0",
    "@jakubmazanec/eslint-config": "^5.0.0",
    "@jakubmazanec/fs-utils": "^0.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.19.1",
    "@types/semver": "^7.8.0",
    "@types/zen-observable": "^0.8.7",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.6",
    "del-cli": "^7.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "execa": "^10.1.0",
    "fs-extra": "^11.4.1",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^2.5.22",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zen-observable": "^0.10.0"
  },
  "peerDependencies": {
    "@jakubmazanec/carson": "^3.0.0"
  },
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.21.0"
  }
}
