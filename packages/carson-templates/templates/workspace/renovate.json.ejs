---
to: 'renovate.json'
strategy: overwrite
---
<%
let nonMajorGroup = {
  matchPackageNames: [`!${CARSON_PACKAGE_NAME}`, `!${TEMPLATE_PACKAGE_NAME}`],
  groupName: 'all non-major dependencies',
  schedule: ['before 6am on monday'],
};

let hasTemplatesProject = workspace.projects.find(
  (project) => project.name === TEMPLATE_PACKAGE_NAME,
);

let renovateConfig = lodash.merge(
  {
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
      ':dependencyDashboard',
      ':ignoreModulesAndTests',
      'group:monorepos',
      'group:recommended',
      'replacements:all',
      'workarounds:all',
    ],

    enabledManagers: ['npm', 'nodenv', 'nvm', 'github-actions'],
    rangeStrategy: 'bump',
    minimumReleaseAge: '14 days',

    packageRules: [
      {
        matchUpdateTypes: ['major', 'minor', 'patch'],
        matchDepTypes: ['devDependencies'],
      },
      {
        matchDepTypes: ['peerDependencies'],
        rangeStrategy: 'replace',
      },
      {
        matchDepTypes: ['overrides'],
        enabled: false,
      },
      {...nonMajorGroup, matchUpdateTypes: ['patch', 'pin', 'digest']},
      {...nonMajorGroup, matchUpdateTypes: ['minor'], matchCurrentVersion: '>=1.0.0'},
    ],
  },
  hasTemplatesProject ?
    {
      'github-actions': {
        managerFilePatterns: [`/${hasTemplatesProject.relativePath}/templates/.+\\.ya?ml\\.ejs$/`],
      },
    }
  : {},
  workspace.config.overrides?.renovate ?? {},
);
-%>
<%- JSON.stringify(renovateConfig, null, 2) %>


