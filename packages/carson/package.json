{
  "name": "@jakubmazanec/carson",
  "version": "3.0.8",
  "description": "Tool for managing workspace and project configuration.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/tools.git",
    "directory": "packages/carson"
  },
  "license": "AGPL-3.0-only",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "sideEffects": false,
  "type": "module",
  "exports": "./build/main.js",
  "bin": {
    "carson": "bin/carson.js"
  },
  "files": [
    "bin",
    "build",
    "source"
  ],
  "scripts": {
    "build": "del-cli build tsconfig.tsbuildinfo && esbuild \"source/**/*\" --platform=node --target=node26.13 --outdir=build --sourcemap && tsc",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "develop": "concurrently \"esbuild \"source/**/*\" --platform=node --target=node26.13 --outdir=build --sourcemap --watch\" \"tsc --watch\"",
    "document": "del-cli docs && typedoc --options typedoc.config.cjs",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint . --quiet",
    "start": "tsx source/run.ts",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@jakubmazanec/args": "^2.0.0",
    "@jakubmazanec/cli": "^0.5.0",
    "@jakubmazanec/error": "^3.0.0",
    "@jakubmazanec/fs-utils": "^0.2.0",
    "@jakubmazanec/template": "^2.0.0",
    "@jakubmazanec/ts-utils": "^3.0.0",
    "@jakubmazanec/zod-utils": "^3.0.0",
    "chalk": "^6.0.1",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "fs-extra": "^11.4.1",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.3",
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.1",
    "zen-observable": "^0.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jakubmazanec/eslint-config": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/zen-observable": "^0.8.7",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "del-cli": "^8.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "ink": "^6.8.0",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "ink": "6.x",
    "react": "19.x"
  },
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "^26.13.0",
    "npm": "^12.2.1"
  }
}
