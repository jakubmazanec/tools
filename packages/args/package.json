{
  "name": "@jakubmazanec/args",
  "version": "2.0.19",
  "description": "TypeScript-first library for parsing command line arguments.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/tools.git",
    "directory": "packages/args"
  },
  "license": "LGPL-3.0-only",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "sideEffects": false,
  "type": "module",
  "exports": "./build/main.js",
  "files": [
    "build",
    "source"
  ],
  "scripts": {
    "build": "del-cli build tsconfig.tsbuildinfo && esbuild \"source/**/*\" --platform=node --target=node24.21 --outdir=build --sourcemap && tsc",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "develop": "concurrently \"esbuild \"source/**/*\" --platform=node --target=node24.21 --outdir=build --sourcemap --watch\" \"tsc --watch\"",
    "document": "del-cli docs && typedoc --options typedoc.config.cjs",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@jakubmazanec/error": "^3.0.0",
    "@jakubmazanec/ts-utils": "^3.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@jakubmazanec/eslint-config": "^5.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.6",
    "del-cli": "^7.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.21.0"
  }
}
