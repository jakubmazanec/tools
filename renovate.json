{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":ignoreModulesAndTests",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "enabledManagers": ["npm", "nodenv", "nvm", "github-actions"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchDepTypes": ["devDependencies"]
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "replace"
    },
    {
      "matchDepTypes": ["overrides"],
      "enabled": false
    },
    {
      "matchPackageNames": ["!@jakubmazanec/carson", "!@jakubmazanec/carson-templates"],
      "groupName": "all non-major dependencies",
      "schedule": ["before 6am on monday"],
      "matchUpdateTypes": ["patch", "pin", "digest"]
    },
    {
      "matchPackageNames": ["!@jakubmazanec/carson", "!@jakubmazanec/carson-templates"],
      "groupName": "all non-major dependencies",
      "schedule": ["before 6am on monday"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": ">=1.0.0"
    }
  ],
  "github-actions": {
    "managerFilePatterns": ["/packages/carson-templates/templates/.+\\.ya?ml\\.ejs$/"]
  }
}
